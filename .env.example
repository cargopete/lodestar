# The Graph — API key from thegraph.com/studio/apikeys
GRAPH_API_KEY=

# Postgres — direct connection string
DATABASE_URL=postgresql://lodestar:password@localhost:5432/lodestar

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Cron protection (random string — used when crons run on Vercel)
CRON_SECRET=

# Amp — self-hosted ampd node for Horizon event history (optional)
# See: /blog/run-local-amp-node
AMP_ENDPOINT=
AMP_TOKEN=

# Ollama — local inference for Lodie AI assistant (optional)
OLLAMA_URL=
OLLAMA_SECRET=

# Push Protocol — delegator notifications (optional)
# Create a channel at https://push.org and fund it with 50 PUSH tokens
PUSH_CHANNEL_ADDRESS=
PUSH_CHANNEL_PRIVATE_KEY=
PUSH_ENV=staging

# Lodestar developer platform — session signing
# Random secret for signing session cookies (openssl rand -hex 32)
SESSION_SECRET=
# IPFS API — optional override for subgraph artifact uploads (defaults to https://api.thegraph.com/ipfs)
GRAPH_IPFS_URL=

# Indexer-agent management API — for queuing presentPOI actions (bounty claims).
# Point at the management API endpoint (port 8000), exposed via a reverse proxy.
# If the endpoint requires Basic auth, set INDEXER_AGENT_TOKEN="user:password".
INDEXER_AGENT_URL=
INDEXER_AGENT_TOKEN=

# Token API (graph-token-api) — JWT from thegraph.com market.
# Required by the /tokens analytics section. Server-side only; never exposed to the client.
TOKEN_API_KEY=

# Optional RPC overrides for the /tokens contract-vs-EOA classifier.
# Without these, public RPCs (publicnode, llamarpc, 1rpc) are used and
# may throttle under directory fan-out. Provide a private/paid URL to
# raise the ceiling.
MAINNET_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
POLYGON_RPC_URL=
OPTIMISM_RPC_URL=

# Foghorn — network-quality judge backend. Base URL of the self-hosted Foghorn
# API (no trailing slash); the /api/foghorn proxy prepends /v1/. Leave empty to
# disable the /foghorn pages and indexer grade column (they degrade gracefully).
FOGHORN_API_URL=


# Nuthatch: required for the migrated event-derived panels. They fail closed when this origin is
# unavailable; there is no Graph fallback.
SERVABILITY_DEAD_ROUNDS="3"          # RFC-006 D5 (lodestar#59): consecutive probe rounds with no serving
                                     # operator before /subgraphs/[hash] may say "Effectively dead". Floors at 2;
                                     # a gateway-served round can never be dead and resets the count. Rounds are
                                     # persisted in servability_rounds (migrations/016).
NUTHATCH_URL=""                      # e.g. https://nuthatch.<host>.sslip.io
NUTHATCH_USER=""                     # basic-auth user in front of the nest
NUTHATCH_PASSWORD=""                 # basic-auth password
NUTHATCH_DIPS="false"                # serve /api/dips from the dips-nest when "true" (no fallback exists)
NUTHATCH_DIPS_BASE_PATH=""           # which DIPS nest /api/dips/agreements reads; "/dips" (Arbitrum One,
                                     # the default) or "/dips-sepolia", where the lifecycle has rows
NUTHATCH_DISPUTES="false"            # read the disputes cron from graph-allocations-nest instead of the
                                     # gateway (nuthatch#1078). Parity is exact on all eight comparable
                                     # fields; an *accepted* dispute fails the run rather than writing a
                                     # zero burn, because the nest cannot compute it until StakeSlashed
                                     # is indexed (nuthatch#1125). No dispute has ever been accepted.
NUTHATCH_DISPUTES_BASE_PATH=""       # defaults to "/alloc", which fronts graph-allocations-nest
NUTHATCH_ALLOCATIONS="false"         # read the allocations cron from graph-allocations-nest instead of the
                                     # gateway (nuthatch#1078). Count parity is exact at a pinned block
                                     # (258,489 both sides); the nest carries Horizon allocations only, and
                                     # the legacy rows already in Postgres are closed and left alone.
NUTHATCH_ALLOCATIONS_BASE_PATH=""    # defaults to "/alloc"
NUTHATCH_RAV="false"                 # read the RAV (query-fee) cron from graph-allocations-nest instead of
                                     # the gateway (nuthatch#1078). Ids are rebuilt in the subgraph's own
                                     # encoding so the upsert dedupes; the nest is a strict superset of the
                                     # subgraph by nine self-collections it drops (nuthatch#1114).
NUTHATCH_RAV_BASE_PATH=""            # defaults to "/alloc"
NUTHATCH_HORIZON_ACTIVITY="false"    # build the Horizon activity feed from graph-staking-nest (delegation
                                     # events, the SQL /api/delegation-events already serves) and the
                                     # horizon nest (provisions) instead of two subgraphs (nuthatch#1078).
                                     # On this path the gateway key is not consulted at all.
NUTHATCH_HORIZON_BASE_PATH=""        # defaults to "/horizon", which fronts the horizon nest
NUTHATCH_PAYMENTS="false"            # serve /api/payments from graph-allocations-nest (escrow folds) and the
                                     # horizon nest (tally collections) instead of the gateway (nuthatch#1078).
                                     # Ids are rebuilt in the subgraph's encoding; every escrow account and
                                     # tally aggregate agreed with the subgraph at a pinned block.
NUTHATCH_PAYMENTS_BASE_PATH=""       # defaults to "/alloc"
NUTHATCH_FEED="false"                # epoch summaries in /api/feed from graph-allocations-nest (lodestar_epochs)
                                     # instead of the Graph Network subgraph; the other feed sources are unaffected
NUTHATCH_FEED_BASE_PATH=""           # defaults to "/alloc"
NUTHATCH_INDEXERS="false"            # serve /api/indexers from graph-allocations-nest (lodestar_indexers) instead
                                     # of the gateway (nuthatch#1160). Stake, pool, shares and thawing measured exact
                                     # against HorizonStaking's getters on every indexer with stake; display names
                                     # and metadata are null on this path until the ENS and IPFS work lands.
NUTHATCH_INDEXERS_BASE_PATH=""       # defaults to "/alloc"
