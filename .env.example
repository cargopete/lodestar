# The Graph — API key from thegraph.com/studio/apikeys
GRAPH_API_KEY=

# Postgres — direct connection string
DATABASE_URL=postgresql://lodestar:password@localhost:5432/lodestar

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Cron protection (random string — used when crons run on Vercel)
CRON_SECRET=

# Amp — self-hosted ampd node for Horizon event history (optional)
# See: /blog/run-local-amp-node
AMP_ENDPOINT=
AMP_TOKEN=

# Ollama — local inference for Lodie AI assistant (optional)
OLLAMA_URL=
OLLAMA_SECRET=

# graph-advocate — PaulieB's routing agent for Token API / Subgraph Registry queries (optional)
# https://github.com/PaulieB14/graph-advocate
# Free tier: 10 requests/day.
GRAPH_ADVOCATE_URL=https://graph-advocate-production.up.railway.app/

# Token API JWT — for graph-advocate to execute Token API queries (optional)
# Get a free JWT at: https://thegraph.market/auth/tokenapi-env
TOKEN_API_JWT=
