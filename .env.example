# The Graph — API key from thegraph.com/studio/apikeys
GRAPH_API_KEY=

# Supabase — create a free project at supabase.com
SUPABASE_URL=                     # https://[ref].supabase.co
SUPABASE_ANON_KEY=                # eyJ... (safe to share)
SUPABASE_SERVICE_ROLE_KEY=        # eyJ... (keep secret, server-only)
DATABASE_URL=                     # postgres://... (pooled, port 6543)
DATABASE_URL_DIRECT=              # postgres://... (direct, port 5432, migrations only)

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Cron protection (random string, also set in Vercel dashboard)
CRON_SECRET=
